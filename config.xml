<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.kareostudio.gravityshift" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Gravity Shift</name>
    <description>Gravity Shift Arcade Game</description>
    <author email="dev@kareostudio.com" href="https://kareostudio.com">Kareo Studio</author>
    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="android-minSdkVersion" value="23" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="android-compileSdkVersion" value="34" />
    <preference name="Orientation" value="landscape" />
    <preference name="AdMobPlusWebViewAd" value="true" />
    <preference name="Fullscreen" value="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Generic icon - Cordova will auto-resize for all densities -->
    <icon src="res/icon/android/icon.png" />

    <platform name="android">
        <allow-intent href="market:*" />
    </platform>
</widget>
